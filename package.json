{
  "name": "ema-tip",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "_guard": "[ -f /.dockerenv ] || [ \"$CI\" = 'true' ] || (printf '\\nRun via task instead:\\n  task dev / task build / task test\\n\\n' >&2 && exit 1)",
