# Database Connection
DATABASE_URL=postgresql://postgres:password@db:5432/webapp
REDIS_URL=redis://redis:6379

# Auth.js Note: Prod環境では必ず長いランダムな文字列を挿れること
AUTH_SECRET=

# Discord OAuth
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Next.js
# 公開URLをそのまま入れる。本番で https を指定しないと、管理画面の認可がCookie名の不一致で全て404になる
AUTH_URL=
NEXTAUTH_URL=

# Cloudflare
TUNNEL_TOKEN=

# 異常の通知先。未設定なら通知しないため、開発環境では空のままでよい
DISCORD_WEBHOOK_URL=
